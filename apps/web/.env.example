# ============================================================
# Continuum Web (Next.js) — Environment Variables
# Copy this file to apps/web/.env.local and fill in real values.
# Never commit .env.local to git.
# ============================================================

# === API WIRING (REQUIRED) ===
NEXT_PUBLIC_API_URL=http://localhost:8000
# For production deployments (Vercel/Railway), use your backend URL, e.g.:
# NEXT_PUBLIC_API_URL=https://your-app.up.railway.app

# === DATABASE (REQUIRED for Auth.js sessions) ===
# Same Postgres instance used by the API. Adjust password to match docker-compose.
DATABASE_URL=postgresql://continuum:your_postgres_password@localhost:5432/continuum

# === REDIS (OPTIONAL — for cache/session) ===
REDIS_URL=redis://:your_redis_password@localhost:6379

# === AUTH (REQUIRED) ===
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: NEXTAUTH_SECRET here MUST equal SECRET_KEY in apps/api/.env
NEXTAUTH_SECRET=CHANGE_ME_must_match_api_secret_key
NEXTAUTH_URL=http://localhost:3000

# === LLM PROVIDER (FRONTEND-SIDE FEATURES, OPTIONAL) ===
# Used for in-browser AI flows (e.g., embedding tooltips). Most generation runs
# on the backend via NVIDIA NIM; only set this if you've enabled Gemini fallback.
GEMINI_API_KEY=

# === APP SETTINGS ===
NODE_ENV=development

# === EVALUATION (OPTIONAL) ===
# Path to your local Claude Code project logs (read-only) for replication scripts.
CLAUDE_LOGS_PATH=
