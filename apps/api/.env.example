# ============================================================
# Continuum API — Environment Variables
# Copy this file to apps/api/.env and fill in real values.
# Never commit .env to git.
# ============================================================

# === DATABASE CONNECTIONS (REQUIRED) ===
# Update passwords to match docker-compose credentials
DATABASE_URL=postgresql+asyncpg://continuum:your_postgres_password@localhost:5432/continuum
POSTGRES_USER=continuum
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=continuum

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

REDIS_URL=redis://:your_redis_password@localhost:6379
REDIS_PASSWORD=your_redis_password

# === LLM PROVIDER (REQUIRED) ===
# Choose provider: "nvidia" (default) or "bedrock"
LLM_PROVIDER=nvidia

# NVIDIA NIM API keys — get from build.nvidia.com
# Two separate keys are required: one for LLM, one for embeddings
NVIDIA_API_KEY=nvapi-xxxx
NVIDIA_EMBEDDING_API_KEY=nvapi-xxxx

# Optional: Amazon Bedrock alternative (requires AWS credentials configured separately)
# AWS_REGION=us-west-2

# === AUTH (REQUIRED) ===
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: SECRET_KEY here MUST equal NEXTAUTH_SECRET in apps/web/.env.local
# (the frontend signs JWTs; the backend verifies them with the same key)
SECRET_KEY=CHANGE_ME_must_match_nextauth_secret
NEXTAUTH_SECRET=CHANGE_ME_must_match_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# === FRONTEND / API WIRING ===
NEXT_PUBLIC_API_URL=http://localhost:8000

# === APP SETTINGS ===
NODE_ENV=development
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# === OBSERVABILITY (OPTIONAL) ===
# Datadog LLM observability (set to "true" to enable tracing)
DD_TRACE_ENABLED=false

# === EVALUATION SCRIPTS (OPTIONAL) ===
# Path to your local Claude Code project logs, used by evaluation/extract_from_logs.py
# Defaults to ~/.claude/projects/-Users-<you>-continuum/ if unset.
# Per the project's privacy rules, ALLOWED_PROJECT_DIRS in extract_from_logs.py
# restricts which directories can be read.
CLAUDE_LOGS_PATH=
